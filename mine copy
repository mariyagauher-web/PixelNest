<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PixelNest — Premium Digital Templates</title>

<meta name="description"
      content="PixelNest — premium animated websites, templates and custom digital experiences.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

/* =========================================================
   PIXELNEST
   PREMIUM ANIMATED DIGITAL TEMPLATE STORE
   FRONTEND ONLY
========================================================= */

:root{
    --bg:#05040a;
    --bg2:#090711;

    --white:#fff;
    --text:#f7f3ff;
    --muted:#9b94aa;
    --muted2:#6d6779;

    --purple:#8b5cf6;
    --purple2:#b48cff;
    --blue:#5f8cff;
    --pink:#ef7dff;
    --cyan:#65d8ff;

    --card:rgba(255,255,255,.045);
    --border:rgba(255,255,255,.10);

    --radius:24px;
    --container:1240px;

    --mouse-x:50%;
    --mouse-y:20%;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
        radial-gradient(
            circle at var(--mouse-x) var(--mouse-y),
            rgba(139,92,246,.13),
            transparent 28%
        ),
        radial-gradient(
            circle at 10% 30%,
            rgba(72,91,255,.08),
            transparent 30%
        ),
        var(--bg);

    color:var(--text);
    font-family:"Inter",sans-serif;
    overflow-x:hidden;
}

body.modal-open{
    overflow:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button,
input,
textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

::selection{
    background:#a982ff;
    color:#08060d;
}

/* =========================================================
   GLOBAL BACKGROUND
========================================================= */

.background{
    position:fixed;
    inset:0;
    z-index:-10;
    pointer-events:none;
    overflow:hidden;
}

.grid{
    position:absolute;
    inset:0;

    background-image:
        linear-gradient(
            rgba(255,255,255,.035) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.035) 1px,
            transparent 1px
        );

    background-size:70px 70px;

    mask-image:
        linear-gradient(
            to bottom,
            black,
            transparent 75%
        );
}

.orb{
    position:absolute;
    border-radius:50%;
    filter:blur(100px);
    opacity:.23;
    will-change:transform;
}

.orb.one{
    width:430px;
    height:430px;
    background:#6d32ff;
    top:-220px;
    right:4%;
}

.orb.two{
    width:360px;
    height:360px;
    background:#2860ff;
    left:-220px;
    top:42%;
}

.orb.three{
    width:300px;
    height:300px;
    background:#e65cff;
    right:-160px;
    bottom:8%;
}

.mouse-glow{
    position:fixed;
    width:420px;
    height:420px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(158,110,255,.13),
            transparent 68%
        );

    transform:
        translate(
            calc(var(--mouse-x) - 210px),
            calc(var(--mouse-y) - 210px)
        );

    pointer-events:none;
    z-index:-1;
}

/* =========================================================
   CUSTOM CURSOR
========================================================= */

.cursor-dot,
.cursor-ring{
    position:fixed;
    top:0;
    left:0;

    pointer-events:none;
    z-index:9999;

    transform:translate(-50%,-50%);
}

.cursor-dot{
    width:6px;
    height:6px;
    border-radius:50%;
    background:white;

    box-shadow:
        0 0 15px rgba(255,255,255,.8);
}

.cursor-ring{
    width:34px;
    height:34px;

    border:1px solid rgba(255,255,255,.35);
    border-radius:50%;

    transition:
        width .2s ease,
        height .2s ease,
        border-color .2s ease,
        background .2s ease;
}

.cursor-ring.active{
    width:52px;
    height:52px;

    background:rgba(139,92,246,.10);
    border-color:rgba(190,157,255,.7);
}

@media(max-width:800px){

    .cursor-dot,
    .cursor-ring{
        display:none;
    }
}

/* =========================================================
   CONTAINER
========================================================= */

.container{
    width:min(
        var(--container),
        calc(100% - 40px)
    );

    margin:auto;
}

/* =========================================================
   NAVBAR
========================================================= */

.navbar{
    position:sticky;
    top:0;

    z-index:1000;

    border-bottom:
        1px solid rgba(255,255,255,.06);

    background:
        rgba(5,4,10,.68);

    backdrop-filter:blur(22px);
    -webkit-backdrop-filter:blur(22px);
}

.nav-inner{
    min-height:76px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    gap:25px;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
}

.brand-icon{
    width:43px;
    height:43px;

    overflow:hidden;

    border-radius:13px;

    border:
        1px solid rgba(180,140,255,.35);

    background:#000;

    box-shadow:
        0 0 30px rgba(139,92,246,.25);
}

.brand-icon img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.brand-name{
    font-family:"Space Grotesk";
    font-size:19px;
    font-weight:700;
}

.brand-name span{
    color:var(--purple2);
}

.nav-links{
    display:flex;
    align-items:center;
    gap:28px;

    color:#aaa4b6;
    font-size:13px;
}

.nav-links a{
    position:relative;
    transition:.25s ease;
}

.nav-links a::after{
    content:"";

    position:absolute;

    left:0;
    bottom:-8px;

    width:0;
    height:1px;

    background:linear-gradient(
        90deg,
        var(--purple),
        var(--pink)
    );

    transition:.3s ease;
}

.nav-links a:hover{
    color:white;
}

.nav-links a:hover::after{
    width:100%;
}

.nav-actions{
    display:flex;
    gap:10px;
}

.nav-instagram{
    padding:10px 16px;

    border-radius:100px;

    border:
        1px solid rgba(255,255,255,.10);

    background:
        rgba(255,255,255,.04);

    font-size:12px;

    transition:.25s ease;
}

.nav-instagram:hover{
    border-color:
        rgba(180,140,255,.5);

    box-shadow:
        0 0 25px rgba(139,92,246,.18);
}

/* =========================================================
   HERO
========================================================= */

.hero{
    position:relative;

    min-height:760px;

    display:flex;
    align-items:center;

    padding:100px 0 90px;

    overflow:hidden;
}

.hero::before{
    content:"";

    position:absolute;

    width:700px;
    height:700px;

    right:-260px;
    top:-180px;

    border-radius:50%;

    background:
        conic-gradient(
            from 0deg,
            rgba(139,92,246,.16),
            rgba(95,140,255,.10),
            rgba(239,125,255,.13),
            rgba(139,92,246,.16)
        );

    filter:blur(80px);

    animation:
        heroGradient 12s linear infinite;
}

@keyframes heroGradient{

    to{
        transform:rotate(360deg);
    }
}

.hero-content{
    position:relative;
    z-index:5;

    width:57%;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:9px;

    padding:9px 14px;

    border:
        1px solid rgba(180,140,255,.20);

    background:
        rgba(139,92,246,.08);

    border-radius:100px;

    color:#c7b7dd;

    font-size:11px;

    margin-bottom:28px;

    animation:
        fadeUp .8s ease both;
}

.eyebrow-dot{
    width:6px;
    height:6px;

    border-radius:50%;

    background:#b17cff;

    box-shadow:
        0 0 14px #ad7aff;

    animation:pulse 2s ease infinite;
}

@keyframes pulse{

    50%{
        transform:scale(1.5);
        opacity:.55;
    }
}

.hero h1{
    max-width:850px;

    font-family:"Space Grotesk";

    font-size:
        clamp(52px,6.7vw,92px);

    line-height:.96;

    letter-spacing:-5px;

    animation:
        fadeUp .8s .08s ease both;
}

.gradient-text{
    background:
        linear-gradient(
            110deg,
            #fff 5%,
            #d9c6ff 38%,
            #9b6cff 65%,
            #f2a7ff 100%
        );

    background-size:200% auto;

    -webkit-background-clip:text;
    background-clip:text;

    color:transparent;

    animation:
        textGradient 6s linear infinite;
}

@keyframes textGradient{

    to{
        background-position:200% center;
    }
}

.hero-text{
    max-width:600px;

    margin-top:28px;

    color:#9d97aa;

    line-height:1.8;

    font-size:15px;

    animation:
        fadeUp .8s .16s ease both;
}

.hero-buttons{
    display:flex;
    gap:12px;

    margin-top:36px;

    animation:
        fadeUp .8s .24s ease both;
}

.btn{
    min-height:49px;

    display:inline-flex;
    align-items:center;
    justify-content:center;

    padding:0 21px;

    border-radius:13px;

    font-size:13px;
    font-weight:700;

    border:1px solid transparent;

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        background .25s ease;
}

.btn:hover{
    transform:translateY(-3px);
}

.btn-primary{
    color:#0b0810;

    background:
        linear-gradient(
            135deg,
            #fff,
            #ded0ff
        );

    box-shadow:
        0 12px 45px rgba(188,153,255,.12);
}

.btn-primary:hover{
    box-shadow:
        0 18px 55px rgba(188,153,255,.25);
}

.btn-secondary{
    color:#fff;

    border-color:
        rgba(255,255,255,.11);

    background:
        rgba(255,255,255,.04);
}

.btn-secondary:hover{
    border-color:
        rgba(180,140,255,.45);

    background:
        rgba(139,92,246,.10);
}

/* =========================================================
   HERO VISUAL
========================================================= */

.hero-visual{
    position:absolute;

    right:-4%;
    top:125px;

    width:49%;
    max-width:620px;

    z-index:2;

    perspective:1400px;
}

.visual-window{
    position:relative;

    padding:11px;

    border-radius:24px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.13),
            rgba(255,255,255,.025)
        );

    border:
        1px solid rgba(255,255,255,.14);

    box-shadow:
        0 45px 120px rgba(0,0,0,.65),
        0 0 110px rgba(104,58,255,.20);

    transform:
        rotateY(-9deg)
        rotateX(4deg)
        rotateZ(1deg);

    animation:
        floatingWindow 7s ease-in-out infinite;

    transition:
        transform .2s ease;
}

@keyframes floatingWindow{

    0%,100%{
        transform:
            rotateY(-9deg)
            rotateX(4deg)
            rotateZ(1deg)
            translateY(0);
    }

    50%{
        transform:
            rotateY(-7deg)
            rotateX(2deg)
            rotateZ(0deg)
            translateY(-14px);
    }
}

.window-top{
    height:35px;

    display:flex;
    align-items:center;

    gap:6px;

    padding:0 10px;
}

.window-dot{
    width:8px;
    height:8px;

    border-radius:50%;

    background:rgba(255,255,255,.35);
}

.window-body{
    position:relative;

    min-height:400px;

    overflow:hidden;

    border-radius:15px;

    padding:25px;

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(130,82,255,.24),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #171124,
            #08070d
        );
}

.window-body::before{
    content:"";

    position:absolute;

    width:220px;
    height:220px;

    right:-80px;
    bottom:-80px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(233,112,255,.35),
            transparent 70%
        );

    filter:blur(20px);

    animation:
        blobMove 7s ease-in-out infinite;
}

@keyframes blobMove{

    50%{
        transform:
            translate(-100px,-50px)
            scale(1.3);
    }
}

.fake-nav{
    position:relative;
    z-index:2;

    display:flex;
    justify-content:space-between;
    align-items:center;

    margin-bottom:38px;
}

.fake-logo{
    width:75px;
    height:10px;

    border-radius:20px;

    background:
        linear-gradient(
            90deg,
            #b18aff,
            #ff99e9
        );
}

.fake-nav-lines{
    display:flex;
    gap:7px;
}

.fake-nav-lines span{
    width:35px;
    height:7px;

    border-radius:20px;

    background:rgba(255,255,255,.10);
}

.hero-preview{
    position:relative;
    z-index:2;

    display:grid;
    grid-template-columns:1.2fr .8fr;

    gap:20px;
}

.preview-copy{
    padding-top:20px;
}

.preview-label{
    width:85px;
    height:7px;

    border-radius:20px;

    background:#8e6aff;

    margin-bottom:20px;
}

.preview-title{
    width:90%;
    height:35px;

    border-radius:10px;

    background:
        linear-gradient(
            90deg,
            rgba(255,255,255,.95),
            rgba(180,140,255,.45)
        );

    margin-bottom:13px;
}

.preview-title.small{
    width:65%;
    height:22px;
}

.preview-text{
    width:85%;
    height:9px;

    border-radius:20px;

    background:rgba(255,255,255,.10);

    margin-bottom:8px;
}

.preview-text.short{
    width:60%;
}

.preview-button{
    width:105px;
    height:35px;

    border-radius:10px;

    margin-top:23px;

    background:
        linear-gradient(
            135deg,
            #fff,
            #d4c0ff
        );
}

.preview-image{
    min-height:250px;

    border-radius:18px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.15),
            rgba(255,255,255,.025)
        );

    border:
        1px solid rgba(255,255,255,.08);

    position:relative;
    overflow:hidden;
}

.preview-image::before{
    content:"";

    position:absolute;

    inset:15%;

    border-radius:50%;

    background:
        linear-gradient(
            135deg,
            #8d5cff,
            #e976ff,
            #5b8fff
        );

    filter:blur(25px);

    animation:
        imageGlow 5s ease-in-out infinite;
}

@keyframes imageGlow{

    50%{
        transform:
            scale(1.25)
            rotate(15deg);
    }
}

.preview-image::after{
    content:"";

    position:absolute;

    width:90px;
    height:90px;

    right:15px;
    top:15px;

    border-radius:22px;

    background:
        rgba(255,255,255,.12);

    border:
        1px solid rgba(255,255,255,.18);

    backdrop-filter:blur(12px);
}

/* =========================================================
   FLOATING PARTICLES
========================================================= */

.particles{
    position:absolute;
    inset:0;
    pointer-events:none;
}

.particle{
    position:absolute;

    width:4px;
    height:4px;

    border-radius:50%;

    background:#b795ff;

    box-shadow:
        0 0 14px #a978ff;

    opacity:.55;

    animation:
        particleFloat
        var(--duration)
        ease-in-out
        infinite;
}

@keyframes particleFloat{

    0%,100%{
        transform:translateY(0);
        opacity:.25;
    }

    50%{
        transform:
            translateY(-35px)
            scale(1.4);

        opacity:.8;
    }
}

/* =========================================================
   FADE UP
========================================================= */

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(20px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* =========================================================
   TRUST
========================================================= */

.trust{
    border-top:
        1px solid rgba(255,255,255,.05);

    border-bottom:
        1px solid rgba(255,255,255,.05);

    padding:25px 0;
}

.trust-inner{
    display:flex;
    justify-content:center;
    align-items:center;

    gap:55px;

    color:#686273;

    font-size:12px;

    flex-wrap:wrap;
}

.trust strong{
    color:#aaa4b2;
}

/* =========================================================
   SECTIONS
========================================================= */

.section{
    padding:120px 0;
}

.section-heading{
    max-width:750px;

    text-align:center;

    margin:
        0 auto 55px;
}

.section-tag{
    color:#a987dc;

    font-size:11px;

    text-transform:uppercase;

    letter-spacing:2.2px;

    margin-bottom:17px;
}

.section-heading h2{
    font-family:"Space Grotesk";

    font-size:
        clamp(36px,5vw,58px);

    line-height:1.03;

    letter-spacing:-2.8px;
}

.section-heading p{
    margin-top:18px;

    color:var(--muted);

    font-size:14px;

    line-height:1.75;
}

/* =========================================================
   STORE TOOLBAR
========================================================= */

.store-tools{
    display:flex;
    justify-content:space-between;
    align-items:end;

    gap:20px;

    margin-bottom:20px;
}

.category-title{
    font-family:"Space Grotesk";

    font-size:18px;
}

.search-box{
    width:310px;

    position:relative;
}

.search-box input{
    width:100%;
    height:47px;

    padding:
        0 15px 0 43px;

    border-radius:14px;

    border:
        1px solid rgba(255,255,255,.09);

    background:
        rgba(255,255,255,.035);

    color:white;

    outline:none;

    font-size:12px;

    transition:.25s ease;
}

.search-box input:focus{
    border-color:
        rgba(169,123,255,.55);

    box-shadow:
        0 0 0 4px rgba(139,92,246,.06);
}

.search-icon{
    position:absolute;

    left:15px;
    top:50%;

    transform:translateY(-50%);

    color:#777080;

    font-size:17px;
}

/* =========================================================
   CATEGORIES
========================================================= */

.category-wrapper{
    position:relative;

    margin-bottom:45px;
}

.category-scroll{
    display:flex;

    gap:9px;

    overflow-x:auto;

    padding:
        4px 2px 12px;

    scrollbar-width:none;

    cursor:grab;
}

.category-scroll::-webkit-scrollbar{
    display:none;
}

.category-scroll.dragging{
    cursor:grabbing;
}

.category-btn{
    flex:0 0 auto;

    padding:10px 16px;

    border-radius:100px;

    border:
        1px solid rgba(255,255,255,.08);

    background:
        rgba(255,255,255,.025);

    color:#8f899a;

    font-size:11px;

    transition:.25s ease;
}

.category-btn:hover{
    color:white;

    border-color:
        rgba(180,140,255,.35);

    transform:translateY(-2px);
}

.category-btn.active{
    color:white;

    background:
        linear-gradient(
            135deg,
            rgba(139,92,246,.35),
            rgba(95,140,255,.15)
        );

    border-color:
        rgba(166,125,255,.50);

    box-shadow:
        0 0 28px rgba(139,92,246,.13);
}

/* =========================================================
   TEMPLATE RAIL
========================================================= */

.products-viewport{
    position:relative;
}

.products-grid{
    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:22px;
}

/* =========================================================
   PRODUCT CARD
========================================================= */

.product-card{
    position:relative;

    overflow:hidden;

    border-radius:
        var(--radius);

    border:
        1px solid var(--border);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.055),
            rgba(255,255,255,.015)
        );

    transform-style:preserve-3d;

    transition:
        transform .15s ease,
        border-color .3s ease,
        box-shadow .3s ease;

    animation:
        cardIn .55s ease both;

    will-change:transform;
}

.product-card::before{
    content:"";

    position:absolute;

    width:230px;
    height:230px;

    border-radius:50%;

    left:
        var(--card-x,50%);

    top:
        var(--card-y,50%);

    transform:
        translate(-50%,-50%);

    background:
        radial-gradient(
            circle,
            rgba(177,124,255,.20),
            transparent 68%
        );

    opacity:0;

    pointer-events:none;

    transition:opacity .25s ease;
}

.product-card:hover::before{
    opacity:1;
}

.product-card:hover{
    border-color:
        rgba(170,125,255,.38);

    box-shadow:
        0 35px 90px rgba(0,0,0,.50),
        0 0 50px rgba(117,70,255,.10);
}

@keyframes cardIn{

    from{
        opacity:0;
        transform:
            translateY(25px)
            scale(.98);
    }

    to{
        opacity:1;
        transform:
            translateY(0)
            scale(1);
    }
}

/* =========================================================
   PRODUCT MEDIA
========================================================= */

.product-media{
    position:relative;

    aspect-ratio:16/10;

    overflow:hidden;

    background:#08070d;
}

.product-media img{
    width:100%;
    height:100%;

    object-fit:cover;

    display:block;

    transition:
        transform .6s ease;
}

.product-card:hover
.product-media img{
    transform:scale(1.055);
}

.product-media::after{
    content:"";

    position:absolute;

    inset:0;

    pointer-events:none;

    background:
        linear-gradient(
            to top,
            rgba(0,0,0,.42),
            transparent 55%
        );
}

.demo-badge{
    position:absolute;

    left:13px;
    top:13px;

    z-index:5;

    padding:7px 10px;

    border-radius:9px;

    background:
        rgba(0,0,0,.55);

    border:
        1px solid rgba(255,255,255,.12);

    backdrop-filter:blur(10px);

    color:#e2dce9;

    font-size:9px;

    letter-spacing:.6px;
}

.media-shine{
    position:absolute;

    inset:-100%;

    z-index:3;

    background:
        linear-gradient(
            120deg,
            transparent 40%,
            rgba(255,255,255,.12),
            transparent 60%
        );

    transform:
        translateX(-100%)
        rotate(10deg);

    transition:
        transform .8s ease;

    pointer-events:none;
}

.product-card:hover
.media-shine{
    transform:
        translateX(100%)
        rotate(10deg);
}

/* =========================================================
   PRODUCT INFO
========================================================= */

.product-info{
    padding:20px;
}

.product-top{
    display:flex;

    justify-content:space-between;
    align-items:flex-start;

    gap:15px;
}

.product-name{
    font-family:"Space Grotesk";

    font-size:18px;
    font-weight:600;

    line-height:1.2;
}

.product-category{
    color:#9b87b8;

    font-size:10px;

    margin-top:6px;
}

.product-description{
    color:#827b8d;

    font-size:11px;

    line-height:1.65;

    margin-top:13px;

    min-height:37px;
}

.price{
    color:white;

    font-family:"Space Grotesk";

    font-size:18px;

    font-weight:700;

    white-space:nowrap;
}

.product-actions{
    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:9px;

    margin-top:20px;
}

.product-btn{
    height:42px;

    border-radius:11px;

    border:
        1px solid rgba(255,255,255,.09);

    background:
        rgba(255,255,255,.035);

    color:#d8d2df;

    font-size:11px;

    font-weight:600;

    transition:.25s ease;
}

.product-btn:hover{
    border-color:
        rgba(180,140,255,.45);

    background:
        rgba(139,92,246,.11);

    transform:translateY(-2px);
}

.product-btn.buy{
    color:#0a0710;

    background:
        linear-gradient(
            135deg,
            #fff,
            #ded0ff
        );

    border-color:white;
}

.product-btn.buy:hover{
    background:#fff;

    box-shadow:
        0 10px 30px rgba(188,153,255,.18);
}

/* =========================================================
   NO RESULTS
========================================================= */

.no-results{
    grid-column:1/-1;

    text-align:center;

    padding:85px 20px;

    border:
        1px dashed rgba(255,255,255,.11);

    border-radius:22px;

    color:#777080;
}

/* =========================================================
   FEATURE SECTION
========================================================= */

.features{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:15px;
}

.feature-card{
    position:relative;

    padding:28px 23px;

    border-radius:20px;

    border:
        1px solid rgba(255,255,255,.07);

    background:
        rgba(255,255,255,.025);

    overflow:hidden;

    transition:.35s ease;
}

.feature-card::before{
    content:"";

    position:absolute;

    width:140px;
    height:140px;

    right:-80px;
    top:-80px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(139,92,246,.20),
            transparent 70%
        );

    transition:.35s ease;
}

.feature-card:hover{
    transform:translateY(-7px);

    border-color:
        rgba(180,140,255,.25);

    background:
        rgba(139,92,246,.045);
}

.feature-card:hover::before{
    transform:scale(1.6);
}

.feature-icon{
    width:40px;
    height:40px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:12px;

    background:
        rgba(139,92,246,.10);

    border:
        1px solid rgba(180,140,255,.14);

    margin-bottom:20px;

    font-size:16px;
}

.feature-card h3{
    font-family:"Space Grotesk";

    font-size:15px;

    margin-bottom:9px;
}

.feature-card p{
    color:#817a8b;

    font-size:11px;

    line-height:1.7;
}

/* =========================================================
   CUSTOM SECTION
========================================================= */

.custom-section{
    position:relative;

    overflow:hidden;

    border:
        1px solid rgba(180,140,255,.13);

    border-radius:32px;

    padding:70px;

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(117,64,255,.20),
            transparent 32%
        ),
        rgba(255,255,255,.025);
}

.custom-section::before{
    content:"";

    position:absolute;

    width:400px;
    height:400px;

    right:-170px;
    bottom:-220px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(231,99,255,.25),
            transparent 65%
        );

    filter:blur(30px);

    animation:
        customBlob 8s ease-in-out infinite;
}

@keyframes customBlob{

    50%{
        transform:
            translate(-100px,-80px)
            scale(1.3);
    }
}

.custom-content{
    position:relative;
    z-index:2;

    max-width:740px;
}

.custom-content h2{
    font-family:"Space Grotesk";

    font-size:
        clamp(35px,4.7vw,56px);

    letter-spacing:-2.5px;

    line-height:1.02;
}

.custom-content p{
    color:#928a9d;

    line-height:1.8;

    font-size:14px;

    margin-top:20px;
}

.custom-highlight{
    margin-top:25px;

    padding:17px 19px;

    border-left:
        2px solid #9c6cff;

    background:
        rgba(139,92,246,.06);

    color:#b9b1c4;

    font-size:12px;

    line-height:1.75;
}

/* =========================================================
   INSTAGRAM
========================================================= */

.instagram-section{
    display:grid;

    grid-template-columns:
        1.2fr .8fr;

    gap:40px;

    align-items:center;
}

.instagram-copy h2{
    font-family:"Space Grotesk";

    font-size:
        clamp(36px,5vw,60px);

    line-height:.98;

    letter-spacing:-3px;
}

.instagram-copy p{
    max-width:530px;

    color:#91899c;

    line-height:1.8;

    font-size:14px;

    margin-top:20px;
}

.instagram-card{
    display:flex;
    justify-content:center;

    padding:30px;

    border-radius:27px;

    border:
        1px solid rgba(255,255,255,.08);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.06),
            rgba(255,255,255,.015)
        );

    box-shadow:
        0 30px 80px rgba(0,0,0,.30);
}

.qr-frame{
    width:min(100%,300px);

    padding:17px;

    border-radius:20px;

    background:#fff;

    box-shadow:
        0 20px 60px rgba(0,0,0,.35);
}

.qr-frame img{
    width:100%;

    display:block;

    border-radius:9px;
}

.qr-label{
    color:#1a1320;

    text-align:center;

    font-size:11px;

    font-weight:800;

    letter-spacing:1.5px;

    padding-top:13px;
}

/* =========================================================
   FOOTER
========================================================= */

footer{
    border-top:
        1px solid rgba(255,255,255,.06);

    padding:45px 0 30px;

    background:
        rgba(0,0,0,.18);
}

.footer-inner{
    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:30px;
}

.footer-brand{
    display:flex;

    align-items:center;

    gap:10px;
}

.footer-brand img{
    width:34px;
    height:34px;

    object-fit:cover;

    border-radius:9px;
}

.footer-brand span{
    font-family:"Space Grotesk";

    font-weight:600;
}

.footer-links{
    display:flex;

    gap:20px;

    color:#777080;

    font-size:11px;
}

.footer-links a:hover{
    color:white;
}

.copyright{
    margin-top:28px;

    text-align:center;

    color:#514c58;

    font-size:10px;
}

/* =========================================================
   PREVIEW OVERLAY
========================================================= */

.preview-overlay{
    position:fixed;

    inset:0;

    z-index:4000;

    display:none;

    background:
        rgba(3,2,7,.82);

    backdrop-filter:blur(18px);

    padding:20px;
}

.preview-overlay.active{
    display:flex;

    animation:
        previewFade .3s ease;
}

@keyframes previewFade{

    from{
        opacity:0;
    }

    to{
        opacity:1;
    }
}

.preview-box{
    width:min(1200px,100%);
    height:min(850px,94vh);

    margin:auto;

    border-radius:24px;

    overflow:hidden;

    border:
        1px solid rgba(255,255,255,.12);

    background:#08070c;

    box-shadow:
        0 40px 120px rgba(0,0,0,.70);

    transform:
        translateY(20px)
        scale(.97);

    animation:
        previewIn .4s ease forwards;
}

@keyframes previewIn{

    to{
        transform:
            translateY(0)
            scale(1);
    }
}

.preview-header{
    height:58px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 15px;

    border-bottom:
        1px solid rgba(255,255,255,.08);

    background:
        rgba(12,9,18,.92);
}

.preview-header-title{
    font-family:"Space Grotesk";

    font-size:13px;
}

.preview-header-actions{
    display:flex;

    gap:8px;
}

.preview-open{
    height:34px;

    padding:0 13px;

    border-radius:9px;

    border:
        1px solid rgba(255,255,255,.10);

    background:
        rgba(255,255,255,.04);

    color:white;

    font-size:10px;
}

.preview-close{
    width:34px;
    height:34px;

    border-radius:9px;

    border:
        1px solid rgba(255,255,255,.10);

    background:
        rgba(255,255,255,.04);

    color:#bbb4c4;

    font-size:17px;
}

.preview-close:hover,
.preview-open:hover{
    background:
        rgba(139,92,246,.12);

    border-color:
        rgba(180,140,255,.4);

    color:white;
}

.preview-content{
    height:
        calc(100% - 58px);

    position:relative;

    display:flex;
    align-items:center;
    justify-content:center;

    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(139,92,246,.12),
            transparent 45%
        );
}

.preview-content iframe{
    width:100%;
    height:100%;

    border:0;

    background:white;
}

.preview-placeholder{
    text-align:center;

    max-width:450px;

    padding:30px;
}

.preview-placeholder-icon{
    font-size:45px;

    margin-bottom:15px;
}

.preview-placeholder h3{
    font-family:"Space Grotesk";

    font-size:25px;

    margin-bottom:10px;
}

.preview-placeholder p{
    color:#8d8697;

    font-size:12px;

    line-height:1.7;
}

/* =========================================================
   BUY MODAL
========================================================= */

.modal{
    position:fixed;

    inset:0;

    z-index:5000;

    display:none;

    align-items:center;
    justify-content:center;

    padding:20px;

    background:
        rgba(0,0,0,.76);

    backdrop-filter:blur(15px);
}

.modal.active{
    display:flex;
}

.modal-box{
    width:min(530px,100%);

    max-height:92vh;

    overflow-y:auto;

    padding:28px;

    border-radius:26px;

    border:
        1px solid rgba(255,255,255,.11);

    background:
        linear-gradient(
            145deg,
            #15101f,
            #0b0910
        );

    box-shadow:
        0 45px 110px rgba(0,0,0,.70);

    animation:
        modalIn .3s ease;
}

@keyframes modalIn{

    from{
        opacity:0;
        transform:
            scale(.96)
            translateY(15px);
    }

    to{
        opacity:1;
        transform:
            scale(1)
            translateY(0);
    }
}

.modal-header{
    display:flex;

    justify-content:space-between;

    gap:20px;

    margin-bottom:24px;
}

.modal-title{
    font-family:"Space Grotesk";

    font-size:24px;
}

.modal-subtitle{
    color:#81798b;

    font-size:11px;

    margin-top:5px;
}

.close-modal{
    width:36px;
    height:36px;

    flex:0 0 auto;

    border-radius:10px;

    border:
        1px solid rgba(255,255,255,.08);

    background:
        rgba(255,255,255,.04);

    color:#aaa2b0;

    font-size:18px;
}

.close-modal:hover{
    color:white;

    background:
        rgba(255,255,255,.08);
}

.selected-product{
    padding:14px 16px;

    border-radius:14px;

    border:
        1px solid rgba(139,92,246,.20);

    background:
        rgba(139,92,246,.06);

    margin-bottom:20px;
}

.selected-label{
    color:#80778b;

    font-size:9px;

    text-transform:uppercase;

    letter-spacing:1.5px;
}

.selected-name{
    margin-top:5px;

    font-size:13px;

    font-weight:600;
}

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;

    color:#aaa1b1;

    font-size:11px;

    margin-bottom:7px;
}

.form-group label span{
    color:#a57aff;
}

.form-group input,
.form-group textarea{
    width:100%;

    border:
        1px solid rgba(255,255,255,.08);

    background:
        rgba(255,255,255,.035);

    border-radius:12px;

    color:white;

    outline:none;

    padding:12px 13px;

    font-size:12px;

    transition:.2s ease;
}

.form-group input{
    height:44px;
}

.form-group textarea{
    min-height:105px;

    resize:vertical;
}

.form-group input:focus,
.form-group textarea:focus{
    border-color:
        rgba(168,120,255,.48);

    box-shadow:
        0 0 0 3px rgba(139,92,246,.06);
}

.form-error{
    display:none;

    color:#ff8eae;

    font-size:10px;

    margin-bottom:12px;
}

.telegram-submit{
    width:100%;

    height:49px;

    border:0;

    border-radius:13px;

    background:
        linear-gradient(
            135deg,
            #fff,
            #d9c8ff
        );

    color:#0b0810;

    font-weight:800;

    font-size:12px;

    transition:.25s ease;
}

.telegram-submit:hover{
    transform:translateY(-2px);

    box-shadow:
        0 15px 40px rgba(180,140,255,.16);
}

.form-note{
    text-align:center;

    color:#625b69;

    font-size:9px;

    line-height:1.6;

    margin-top:12px;
}

/* =========================================================
   TOAST
========================================================= */

.toast{
    position:fixed;

    z-index:9000;

    left:50%;
    bottom:25px;

    transform:
        translateX(-50%)
        translateY(20px);

    opacity:0;

    pointer-events:none;

    padding:12px 19px;

    border-radius:100px;

    background:#f5efff;

    color:#130d1d;

    font-size:11px;

    font-weight:700;

    transition:.3s ease;
}

.toast.show{
    opacity:1;

    transform:
        translateX(-50%)
        translateY(0);
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1100px){

    .hero-content{
        width:62%;
    }

    .hero-visual{
        width:50%;
        right:-12%;
        opacity:.78;
    }

    .products-grid{
        grid-template-columns:
            repeat(2,minmax(0,1fr));
    }

    .features{
        grid-template-columns:
            repeat(2,1fr);
    }
}

@media(max-width:800px){

    .container{
        width:
            min(
                var(--container),
                calc(100% - 28px)
            );
    }

    .nav-links{
        display:none;
    }

    .nav-inner{
        min-height:68px;
    }

    .hero{
        min-height:auto;

        padding:
            80px 0 70px;
    }

    .hero-content{
        width:100%;

        text-align:center;
    }

    .hero h1{
        letter-spacing:-3px;
    }

    .hero-text{
        margin-left:auto;
        margin-right:auto;
    }

    .hero-buttons{
        justify-content:center;
    }

    .hero-visual{
        position:relative;

        width:100%;

        right:auto;
        top:auto;

        margin-top:60px;

        opacity:1;
    }

    .visual-window{
        transform:none;

        animation:
            floatingWindowMobile
            7s ease-in-out infinite;
    }

    @keyframes floatingWindowMobile{

        50%{
            transform:translateY(-8px);
        }
    }

    .store-tools{
        flex-direction:column;
        align-items:stretch;
    }

    .search-box{
        width:100%;
    }

    .instagram-section{
        grid-template-columns:1fr;
    }

    .instagram-copy{
        text-align:center;
    }

    .instagram-copy p{
        margin-left:auto;
        margin-right:auto;
    }

    .custom-section{
        padding:45px 28px;
    }

    .footer-inner{
        flex-direction:column;
    }
}

@media(max-width:600px){

    .brand-name{
        font-size:16px;
    }

    .nav-instagram{
        display:none;
    }

    .hero{
        padding-top:65px;
    }

    .hero h1{
        font-size:47px;

        letter-spacing:-2.5px;
    }

    .hero-buttons{
        flex-direction:column;
    }

    .hero-buttons .btn{
        width:100%;
    }

    .window-body{
        min-height:330px;

        padding:18px;
    }

    .hero-preview{
        grid-template-columns:1fr;
    }

    .preview-image{
        min-height:160px;
    }

    .products-grid{
        grid-template-columns:1fr;
    }

    .features{
        grid-template-columns:1fr;
    }

    .section{
        padding:85px 0;
    }

    .section-heading{
        margin-bottom:40px;
    }

    .footer-links{
        flex-wrap:wrap;
        justify-content:center;
    }

    .modal-box{
        padding:21px;
    }

    .preview-overlay{
        padding:8px;
    }

    .preview-box{
        height:95vh;
        border-radius:17px;
    }
}

@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{
        animation-duration:.01ms !important;
        animation-iteration-count:1 !important;
        scroll-behavior:auto !important;
        transition-duration:.01ms !important;
    }
}



/* =========================================================
   PIXELNEST HERO — HERO.HTML DESIGN
   Drop-in replacement for main.html hero
========================================================= */

.pn-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    height: 100vh;
    overflow: hidden;
    isolation: isolate;
    background: #080312;
    color: #fff;
}

/* ---------- BACKGROUND SLIDER ---------- */

.pn-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -10;
    overflow: hidden;
}

.pn-hero-slide {
    position: absolute;
    inset: -5%;

    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;

    opacity: 0;
    transform: scale(1.03);

    transition:
        opacity 1.6s cubic-bezier(.22,.61,.36,1),
        transform 6s cubic-bezier(.16,1,.3,1);

    will-change: opacity, transform;
}

.pn-hero-slide.active {
    opacity: 1;
    transform: scale(1.10);
}

/* ---------- DARK OVERLAY ---------- */

.pn-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -8;
    pointer-events: none;

    background:
        linear-gradient(
            90deg,
            rgba(5,2,15,.96) 0%,
            rgba(8,3,20,.86) 24%,
            rgba(8,3,20,.56) 55%,
            rgba(4,2,12,.25) 100%
        ),
        linear-gradient(
            180deg,
            rgba(4,2,12,.48) 0%,
            transparent 35%,
            rgba(3,1,10,.88) 100%
        );
}

/* ---------- AMBIENT PURPLE LIGHT ---------- */

.pn-hero-glow {
    position: absolute;

    width: 700px;
    height: 700px;

    right: -300px;
    top: -350px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(168,85,247,.24),
            rgba(251,191,36,.10) 35%,
            transparent 70%
        );

    filter: blur(50px);

    z-index: -7;
    pointer-events: none;

    animation:
        pnHeroGlow 10s ease-in-out infinite alternate;
}

@keyframes pnHeroGlow {

    from {
        transform: translate(0,0) scale(1);
    }

    to {
        transform: translate(-100px,80px) scale(1.2);
    }

}

/* ---------- NAV ---------- */

.pn-hero-nav {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 100px;

    display: flex;
    align-items: center;

    padding: 0 6%;

    z-index: 50;
}

.pn-hero-logo {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -1px;

    background:
        linear-gradient(
            90deg,
            #fff,
            #fbbf24
        );

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.pn-hero-nav-links {
    margin-left: auto;

    display: flex;
    align-items: center;
    gap: 38px;
}

.pn-hero-nav-links a {
    color: rgba(255,255,255,.78);

    text-decoration: none;

    font-size: 14px;

    transition: .3s ease;
}

.pn-hero-nav-links a:hover {
    color: #fff;
}

.pn-hero-nav-links a.active {
    color: #fbbf24;
}

/* ---------- HERO CONTENT ---------- */

.pn-hero-container {
    position: relative;

    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;

    padding: 100px 8% 80px;
}

.pn-hero-content {
    width: min(720px, 70%);
    z-index: 10;

