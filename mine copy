                );


                closeBuyModal();

            },
            450
        );

    }
);


/* =========================================================
   SEARCH
========================================================= */

searchInput.addEventListener(
    "input",
    renderProducts
);


/* =========================================================
   DRAGGABLE CATEGORY BAR
========================================================= */

let categoryDragging =
    false;

let categoryStartX = 0;

let categoryScrollLeft = 0;


categoryButtons.addEventListener(
    "pointerdown",
    event => {

        categoryDragging =
            true;

        categoryButtons.classList.add(
            "dragging"
        );

        categoryStartX =
            event.clientX;

        categoryScrollLeft =
            categoryButtons.scrollLeft;

    }
);


categoryButtons.addEventListener(
    "pointermove",
    event => {

        if(
            !categoryDragging
        ){
            return;
        }


        const walk =
            event.clientX -
            categoryStartX;


        categoryButtons.scrollLeft =
            categoryScrollLeft -
            walk;

    }
);


[
    "pointerup",
    "pointercancel",
    "pointerleave"
].forEach(
    type => {

        categoryButtons.addEventListener(
            type,
            () => {

                categoryDragging =
                    false;

                categoryButtons.classList
                    .remove(
                        "dragging"
                    );

            }
        );

    }
);


/* =========================================================
   TOAST
========================================================= */

let toastTimer;


function showToast(
    message
){

    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    clearTimeout(
        toastTimer
    );


    toastTimer =
        setTimeout(
            () => {

                toast.classList.remove(
                    "show"
                );

            },
            2800
        );

}


/* =========================================================
   SCROLL REVEAL
========================================================= */

const revealObserver =
    new IntersectionObserver(
        entries => {

            entries.forEach(
                entry => {

                    if(
                        entry.isIntersecting
                    ){

                        entry.target.style
                            .opacity = "1";

                        entry.target.style
                            .transform =
                            "translateY(0)";

                        revealObserver
                            .unobserve(
                                entry.target
                            );

                    }

                }
            );

        },
        {
            threshold:.12
        }
    );


document
    .querySelectorAll(
        ".feature-card,.custom-section,.instagram-section"
    )
    .forEach(
        element => {

            element.style.opacity =
                "0";

            element.style.transform =
                "translateY(25px)";

            element.style.transition =
                "opacity .7s ease, transform .7s ease";


            revealObserver.observe(
                element
            );

        }
    );


/* =========================================================
   INITIALIZE
========================================================= */

createParticles();

createCategories();

renderProducts();




</script>


<script>
/* =========================================================
   PIXELNEST HERO SLIDER
========================================================= */

(function () {

    const HERO_IMAGES = [

        "https://images.unsplash.com/photo-1558655146-9f40138edfeb?auto=format&fit=crop&w=2400&q=90",

        "https://images.unsplash.com/photo-1559028012-481c04fa702d?auto=format&fit=crop&w=2400&q=90",

        "https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=2400&q=90",

        "https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=2400&q=90"

    ];


    const SLIDE_DURATION = 5000;


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const hero =
        document.querySelector(".pn-hero");

    if (!hero) {
        return;
    }


    const slides =
        hero.querySelectorAll(".pn-hero-slide");


    const dots =
        hero.querySelectorAll(".pn-hero-dot");


    const prevBtn =
        document.getElementById("pnHeroPrev");


    const nextBtn =
        document.getElementById("pnHeroNext");


    const currentNumber =
        document.getElementById("pnHeroCurrent");


    let currentSlide = 0;

    let autoplayTimer = null;


    /* =====================================================
       LOAD BACKGROUND IMAGES
    ====================================================== */

    slides.forEach(function (slide, index) {

        if (!HERO_IMAGES[index]) {
            return;
        }

        slide.style.backgroundImage =
            'url("' + HERO_IMAGES[index] + '")';

    });


    /* =====================================================
       PRELOAD IMAGES
    ====================================================== */

    HERO_IMAGES.forEach(function (url) {

        const image = new Image();

        image.src = url;

    });


    /* =====================================================
       SHOW SLIDE
    ====================================================== */

    function showSlide(index) {

        if (!slides.length) {
            return;
        }


        currentSlide =
            (index + slides.length) %
            slides.length;


        slides.forEach(function (slide, i) {

            slide.classList.toggle(
                "active",
                i === currentSlide
            );

        });


        dots.forEach(function (dot, i) {

            dot.classList.toggle(
                "active",
                i === currentSlide
            );

        });


        if (currentNumber) {

            currentNumber.textContent =
                String(currentSlide + 1)
                .padStart(2, "0");

        }

    }


    /* =====================================================
       NEXT
    ====================================================== */

    function nextSlide() {

        showSlide(
            currentSlide + 1
        );

    }


    /* =====================================================
       PREVIOUS
    ====================================================== */

    function previousSlide() {

        showSlide(
            currentSlide - 1
        );

    }


    /* =====================================================
       START AUTOPLAY
    ====================================================== */

    function startAutoplay() {

        clearInterval(autoplayTimer);

        autoplayTimer =
            setInterval(
                nextSlide,
                SLIDE_DURATION
            );

    }


    /* =====================================================
       STOP AUTOPLAY
    ====================================================== */

    function stopAutoplay() {

        clearInterval(
            autoplayTimer
        );

    }


    /* =====================================================
       NEXT BUTTON
    ====================================================== */

    if (nextBtn) {

        nextBtn.addEventListener(
            "click",
            function () {

                nextSlide();

                startAutoplay();

            }
        );

    }


    /* =====================================================
       PREVIOUS BUTTON
    ====================================================== */

    if (prevBtn) {

        prevBtn.addEventListener(
            "click",
            function () {

                previousSlide();

                startAutoplay();

            }
        );

    }


    /* =====================================================
       DOT BUTTONS
    ====================================================== */

    dots.forEach(function (dot) {

        dot.addEventListener(
            "click",
            function () {

                const slideIndex =
                    Number(
                        dot.dataset.slide
                    );


                showSlide(
                    slideIndex
                );


                startAutoplay();

            }
        );

    });


    /* =====================================================
       PAUSE WHEN MOUSE ENTERS HERO
    ====================================================== */

    hero.addEventListener(
        "mouseenter",
        stopAutoplay
    );


    /* =====================================================
       RESUME WHEN MOUSE LEAVES HERO
    ====================================================== */

    hero.addEventListener(
        "mouseleave",
        startAutoplay
    );


    /* =====================================================
       KEYBOARD CONTROLS
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "ArrowRight") {

                nextSlide();

                startAutoplay();

            }


            if (event.key === "ArrowLeft") {

                previousSlide();

                startAutoplay();

            }

        }
    );


    /* =====================================================
       TOUCH SWIPE
    ====================================================== */

    let touchStartX = 0;

    let touchEndX = 0;


    hero.addEventListener(
        "touchstart",
        function (event) {

            touchStartX =
                event.changedTouches[0].screenX;

        },
        {
            passive: true
        }
    );


    hero.addEventListener(
        "touchend",
        function (event) {

            touchEndX =
                event.changedTouches[0].screenX;


            const distance =
                touchEndX - touchStartX;


            if (Math.abs(distance) < 50) {
                return;
            }


            if (distance < 0) {

                nextSlide();

            } else {

                previousSlide();

            }


            startAutoplay();

        },
        {
            passive: true
        }
    );


    /* =====================================================
       REDUCED MOTION
    ====================================================== */

    const reducedMotion =
        window.matchMedia(
            "(prefers-reduced-motion: reduce)"
        );


    /* =====================================================
       INITIALIZE
    ====================================================== */

    showSlide(0);


    if (!reducedMotion.matches) {

        startAutoplay();

    }

})();
</script>

