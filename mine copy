========================================================= */

function isRealDemo(url){

    if(
        !url ||
        typeof url !== "string"
    ){
        return false;
    }


    return !(
        url.includes(
            "your-"
        )

        ||

        url.includes(
            "your_"
        )

        ||

        url.includes(
            "example.com"
        )
    );

}


function openPreview(product){

    previewTitle.textContent =
        product.name;


    currentPreviewUrl =
        product.demoUrl;


    if(
        isRealDemo(
            product.demoUrl
        )
    ){

        previewContent.innerHTML = `

            <iframe
                src="${escapeHTML(product.demoUrl)}"
                title="${escapeHTML(product.name)} preview"
                loading="eager"
            ></iframe>

        `;

        previewOpen.style.display =
            "block";

    }else{

        previewContent.innerHTML = `

            <div class="preview-placeholder">

                <div class="preview-placeholder-icon">
                    ✦
                </div>

                <h3>
                    ${escapeHTML(product.name)}
                </h3>

                <p>
                   <strong> Comming soon...</strong>
                </p>

                <div
                    style="
                        margin-top:20px;
                    "
                >

                    <button
                        class="btn btn-primary"
                        onclick="closePreview()"
                    >
                        Back to Templates
                    </button>

                </div>

            </div>

        `;

        previewOpen.style.display =
            "none";

    }


    previewOverlay.classList.add(
        "active"
    );

    document.body.classList.add(
        "modal-open"
    );

}


function closePreview(){

    previewOverlay.classList.remove(
        "active"
    );

    document.body.classList.remove(
        "modal-open"
    );


    setTimeout(
        () => {

            previewContent.innerHTML =
                "";

        },
        300
    );

}


