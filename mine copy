                .value
                .trim();


        const requirement =
            document
                .getElementById(
                    "customerRequirement"
                )
                .value
                .trim();


        const website =
            selectedProduct.value;


        const price =
            selectedPrice.value;


        if(
            !name ||
            !contact
        ){

            formError.style.display =
                "block";

            return;

        }


        if(
            TELEGRAM_USERNAME ===
            "why_hazel"
        ){

            showToast(
                "Add your Telegram username in the JS settings."
            );

            return;

        }


        const message =

`🌟 PIXELNEST ORDER REQUEST

━━━━━━━━━━━━━━━━━━

🌐 Website:
${website}

💰 Price:
${price}

━━━━━━━━━━━━━━━━━━

👤 Name:
${name}

📱 Instagram / Telegram ID:
${contact}

📧 Email:
${email || "Not provided"}

📝 Requirement:
${requirement || "No additional requirements"}

━━━━━━━━━━━━━━━━━━

Sent from PixelNest
Design • Code • Create`;


        const telegramURL =
